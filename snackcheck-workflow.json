              "type": "string"
            },
            {
              "id": "d59100fc-331f-4a7c-be41-3e4c9380dd3a",
              "name": "nutriscore",
              "value": "={{ ($json.product.nutriscore_grade || 'unknown').toLowerCase() }}",
              "type": "string"
