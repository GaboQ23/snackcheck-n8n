      "notesInFlow": true,
      "notes": "Comprueba que Open Food Facts haya encontrado el producto (status === 1)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"PRODUCT_NOT_FOUND\",\n  \"message\": \"El producto no existe en la base de datos de Open Food Facts.\",\n  \"example_valid_barcode\": \"3017620422003\"\n}",
        "options": {
          "responseCode": 404
