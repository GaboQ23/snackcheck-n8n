      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        3168,
        -272
      ],
      "id": "3a580e85-c227-43c8-8e63-d6f7f89b314e",
      "name": "Respond - Final Verdict Text",
      "notesInFlow": true,
      "notes": "Devuelve el veredicto final formateado como text/plain con HTTP 200."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"service\": \"SnackCheck API\",\n  \"description\": \"Analiza el código de barras de un producto empaquetado usando Open Food Facts y devuelve un veredicto nutricional claro.\",\n  \"method\": \"POST\",\n  \"endpoint\": \"/nutrition-check\",\n  \"required_fields\": {\n    \"barcode\": \"Cadena o número con solo dígitos (ej. 3017620422003)\"\n  },\n  \"example\": {\n    \"barcode\": \"3017620422003\"\n  }\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        -96
      ],
      "id": "ff400b66-a968-4138-932b-2a695676d577",
      "name": "Respond - Self Documentation",
      "notesInFlow": true,
      "notes": "Devuelve JSON 200 autodocumentado cuando no se envía cuerpo en la solicitud."
