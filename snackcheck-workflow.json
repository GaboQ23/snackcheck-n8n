        -176
      ],
      "id": "b577d3ea-bf67-44c3-b4ff-5939858e67d3",
      "name": "Classify - Traffic Light & Verdict",
      "notesInFlow": true,
      "notes": "Clasifica azúcar, sal y grasa según umbrales de semáforo y determina el veredicto general tomando la peor lectura entre semáforo y Nutri-Score."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nlet concernScore = 0;\n\nif (item.sugarFlag === 'alto') concernScore += 1;\nif (item.saltFlag === 'alto') concernScore += 1;\nif (item.fatFlag === 'alto') concernScore += 1;\n\nreturn {\n  json: {\n    ...item,\n    concernScore\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -176
      ],
      "id": "a342e077-ed13-457c-9a16-613ec62b491a",
      "name": "Code - Calculate Concern Score",
      "notesInFlow": true,
      "notes": "Calcula la puntuación de preocupación (0 a 3) sumando los nutrientes marcados en nivel alto sobre un solo ítem."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "716a39ab-cdb9-43fb-895d-acd98a0fe99b",
              "leftValue": "={{ $json.verdictLevel }}",
              "rightValue": "no saludable",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        2016,
        -176
      ],
      "id": "dc2e114d-5815-4ed2-ab16-af9718c8bea3",
      "name": "Route - Verdict Tone",
      "notesInFlow": true,
      "notes": "Enruta productos 'no saludable' hacia el prompt cauteloso y el resto hacia el prompt alentador."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres un amigo honesto y empático que sabe de nutrición y ayuda a alguien en el supermercado.\nEscribe UN SOLO párrafo corto (máximo 3 oraciones, en español natural y cercano) sobre este producto que obtuvo veredicto NO SALUDABLE.\nSé cauteloso pero con delicadeza: explica qué nutriente(s) o Nutri-Score disparan la alerta usando los datos reales y sugiere dejarlo como un gusto ocasional, sin regañar.\n\nDatos del producto:\n- Nombre: {{ $json.productName }} ({{ $json.brands }})\n- Veredicto general: {{ $json.verdictLevel }} (Nutri-Score: {{ $json.nutriscore }})\n- Azúcar: {{ $json.sugars }} g por 100g (nivel: {{ $json.sugarFlag }})\n- Sal: {{ $json.salt }} g por 100g (nivel: {{ $json.saltFlag }})\n- Grasa: {{ $json.fat }} g por 100g (nivel: {{ $json.fatFlag }})",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2320,
        -416
      ],
      "id": "7d1142be-f456-4d7c-b390-7064f8a996b1",
      "name": "AI - Health Verdict (Cautionary)",
      "notesInFlow": true,
      "notes": "Genera un párrafo empático y cauteloso con delicadeza para productos clasificados como no saludables."
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        2352,
        -240
      ],
      "id": "7ed9b4a1-bddd-46c2-ae4f-bb0800afade8",
      "name": "Groq - Cautionary Model",
      "credentials": {
        "groqApi": {
          "id": "1gmSgJl7TYmhRbyz",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres un amigo cercano y entusiasta que sabe de nutrición y acompaña a alguien en el supermercado.\nEscribe UN SOLO párrafo corto (máximo 3 oraciones, en español natural y humano) sobre este producto que obtuvo veredicto {{ $json.verdictLevel.toUpperCase() }}.\nUsa un tono alentador y positivo: destaca sus buenos valores nutricionales usando las cifras reales (y si es moderado, menciona con amabilidad el único punto a vigilar sin quitarle mérito).\n\nDatos del producto:\n- Nombre: {{ $json.productName }} ({{ $json.brands }})\n- Veredicto general: {{ $json.verdictLevel }} (Nutri-Score: {{ $json.nutriscore }})\n- Azúcar: {{ $json.sugars }} g por 100g (nivel: {{ $json.sugarFlag }})\n- Sal: {{ $json.salt }} g por 100g (nivel: {{ $json.saltFlag }})\n- Grasa: {{ $json.fat }} g por 100g (nivel: {{ $json.fatFlag }})",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2240,
        -80
      ],
      "id": "d0b56359-8193-4973-a024-5fa21e57e74d",
      "name": "AI - Health Verdict (Encouraging)",
      "notesInFlow": true,
      "notes": "Genera un párrafo alentador y positivo para productos clasificados como saludables o moderados."
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        2176,
        128
      ],
      "id": "0e3efba9-4462-4d54-abe3-009218b80ee9",
      "name": "Groq - Encouraging Model",
      "credentials": {
        "groqApi": {
          "id": "1gmSgJl7TYmhRbyz",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2720,
        -272
      ],
      "id": "3f86b2a4-7d88-4ed2-8caf-647a04009426",
      "name": "Merge - Combine Verdict Branches",
      "notesInFlow": true,
      "notes": "Une la salida de ambas ramas condicionales de IA mediante Merge Append."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "955b7119-d484-47d7-a6bd-9d83e07b3f7e",
              "name": "verdictText",
              "value": "={{ `${$('Code - Calculate Concern Score').first().json.verdictLevel === 'saludable' ? '🟢' : ($('Code - Calculate Concern Score').first().json.verdictLevel === 'moderado' ? '🟡' : '🔴')} VEREDICTO SNACKCHECK: ${$('Code - Calculate Concern Score').first().json.verdictLevel.toUpperCase()}\\nProducto: ${$('Code - Calculate Concern Score').first().json.productName} (${$('Code - Calculate Concern Score').first().json.brands})\\nNutri-Score: ${$('Code - Calculate Concern Score').first().json.nutriscore.toUpperCase()} | Puntuación de preocupación: ${$('Code - Calculate Concern Score').first().json.concernScore}/3\\n\\n📊 NUTRIENTES POR 100 g:\\n• Azúcar: ${$('Code - Calculate Concern Score').first().json.sugars} g ${$('Code - Calculate Concern Score').first().json.sugarFlag === 'alto' ? '🔴' : ($('Code - Calculate Concern Score').first().json.sugarFlag === 'medio' ? '🟡' : '🟢')} (${$('Code - Calculate Concern Score').first().json.sugarFlag})\\n• Sal: ${$('Code - Calculate Concern Score').first().json.salt} g ${$('Code - Calculate Concern Score').first().json.saltFlag === 'alto' ? '🔴' : '🟢'} (${$('Code - Calculate Concern Score').first().json.saltFlag})\\n• Grasa: ${$('Code - Calculate Concern Score').first().json.fat} g ${$('Code - Calculate Concern Score').first().json.fatFlag === 'alto' ? '🔴' : '🟢'} (${$('Code - Calculate Concern Score').first().json.fatFlag})\\n• Energía: ${$('Code - Calculate Concern Score').first().json.kcal} kcal\\n\\n💬 OPINIÓN DE SNACKCHECK:\\n${($json.text || '').trim()}` }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2944,
        -272
      ],
      "id": "eda456b0-2611-49f4-9090-ca4586e8447f",
      "name": "Format - Final Verdict Message",
      "notesInFlow": true,
      "notes": "Ensambla el veredicto en texto plano multi-sección con titular, indicadores rojo/verde y párrafo de IA."
