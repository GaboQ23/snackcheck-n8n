      "name": "Validate - Numeric Barcode",
      "notesInFlow": true,
      "notes": "Valida que el campo barcode exista y contenga únicamente dígitos numéricos."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"INVALID_BARCODE\",\n  \"message\": \"El campo 'barcode' es obligatorio y debe ser estrictamente numérico.\",\n  \"example\": {\n    \"barcode\": \"3017620422003\"\n  }\n}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
