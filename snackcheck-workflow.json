          "conditions": [
            {
              "id": "075c2aa8-cfd4-420c-a88c-766c57bbf63e",
              "leftValue": "={{ Boolean($json.product?.nutriments && ['sugars_100g', 'salt_100g', 'fat_100g'].every(k => $json.product.nutriments[k] !== undefined && $json.product.nutriments[k] !== null && $json.product.nutriments[k] !== '')) }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
