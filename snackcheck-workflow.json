              "type": "number"
            },
            {
              "id": "f95e4b4a-3dee-4e25-bfc7-a0c9cbb20b3c",
              "name": "salt",
              "value": "={{ Number($json.product.nutriments.salt_100g) }}",
              "type": "number"
            },
            {
              "id": "087785f6-94c8-46be-b848-1cb97a9e2c9a",
              "name": "fat",
              "value": "={{ Number($json.product.nutriments.fat_100g) }}",
              "type": "number"
            },
            {
              "id": "9e8964e3-12ed-4595-906a-42d54ecf65c7",
              "name": "kcal",
              "value": "={{ $json.product.nutriments['energy-kcal_100g'] ?? 'N/D' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1344,
        -176
      ],
      "id": "95829115-8883-4fea-b561-7b589e8bb8da",
      "name": "Extract - Product & Nutriments",
      "notesInFlow": true,
      "notes": "Extrae en variables planas el nombre, marca, Nutri-Score y nutrientes clave (usando corchetes para energy-kcal_100g)."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1247b3ae-679c-4fd0-beb5-5fa96f466b1c",
              "name": "sugarFlag",
              "value": "={{ $json.sugars > 22.5 ? 'alto' : ($json.sugars >= 5 ? 'medio' : 'bajo') }}",
              "type": "string"
            },
            {
              "id": "eb7103ac-c891-472d-af6d-aebc5b5e52b4",
              "name": "saltFlag",
              "value": "={{ $json.salt > 1.5 ? 'alto' : 'bajo' }}",
              "type": "string"
            },
            {
              "id": "9cca0459-7f4f-467f-890f-0865554ad2f4",
              "name": "fatFlag",
              "value": "={{ $json.fat > 17.5 ? 'alto' : 'bajo' }}",
              "type": "string"
            },
            {
              "id": "b4ec31cf-e265-4028-a642-89b0b8bdc372",
              "name": "trafficReading",
              "value": "={{ (($json.sugars > 22.5 ? 1 : 0) + ($json.salt > 1.5 ? 1 : 0) + ($json.fat > 17.5 ? 1 : 0)) === 0 ? 'saludable' : ((($json.sugars > 22.5 ? 1 : 0) + ($json.salt > 1.5 ? 1 : 0) + ($json.fat > 17.5 ? 1 : 0)) === 1 ? 'moderado' : 'no saludable') }}",
              "type": "string"
            },
            {
              "id": "678a891a-fa68-4f41-b846-26aefce82ddb",
              "name": "nutriscoreReading",
              "value": "={{ ['a', 'b'].includes($json.nutriscore) ? 'saludable' : ($json.nutriscore === 'c' ? 'moderado' : (['d', 'e'].includes($json.nutriscore) ? 'no saludable' : 'unknown')) }}",
              "type": "string"
            },
            {
              "id": "65352c2e-a02a-430f-b0b6-c7d21ab4dac2",
              "name": "verdictLevel",
              "value": "={{ (['no saludable', 'moderado', 'saludable'].find(level => level === ((($json.sugars > 22.5 ? 1 : 0) + ($json.salt > 1.5 ? 1 : 0) + ($json.fat > 17.5 ? 1 : 0)) === 0 ? 'saludable' : ((($json.sugars > 22.5 ? 1 : 0) + ($json.salt > 1.5 ? 1 : 0) + ($json.fat > 17.5 ? 1 : 0)) === 1 ? 'moderado' : 'no saludable')) || level === (['a', 'b'].includes($json.nutriscore) ? 'saludable' : ($json.nutriscore === 'c' ? 'moderado' : (['d', 'e'].includes($json.nutriscore) ? 'no saludable' : 'unknown'))))) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
