      "position": [
        1120,
        -96
      ],
      "id": "f1c6ff1b-9a87-4f71-88dc-d8ed8e19b5a7",
      "name": "Validate - Nutriments Present",
      "notesInFlow": true,
      "notes": "Verifica que existan valores reales de azúcar, sal y grasa por 100 g antes de clasificar."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"INSUFFICIENT_DATA\",\n  \"message\": \"El producto fue encontrado, pero carece de datos nutricionales suficientes (azúcar, sal o grasa por 100 g) para emitir un veredicto.\"\n}",
        "options": {
          "responseCode": 200
