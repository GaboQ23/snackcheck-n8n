      "notes": "Responde HTTP 200 JSON si el producto carece de datos nutricionales utilizables."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a9f71689-1eea-4262-b1c7-0d5cfe382274",
              "name": "productName",
              "value": "={{ $json.product.product_name || 'Producto sin nombre' }}",
              "type": "string"
            },
